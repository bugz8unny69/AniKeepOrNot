# AniKeepOrNot transcode agent. `adm-agent.pyz agent install` writes this
# file with the real paths: system scope keeps User=/Group= and
# multi-user.target; user scope (systemctl --user) drops them and uses
# default.target. Hand installs: replace the paths below. To run the agent from
# a full AniKeepOrNot checkout instead of the archive, use
#   ExecStart=/usr/bin/python3 /opt/anime-discovery/bin/adm agent run
# ExecStart keeps the `server agent run` spelling: every archive version
# understands it, so a rollback to an older archive still starts.
[Unit]
Description=AniKeepOrNot transcode agent (VAAPI/x265 over HTTP)
After=network-online.target
Wants=network-online.target
# Crash recovery: restart after 5 s, but give up after 5 failures in 5 minutes.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=transcode
Group=transcode
SupplementaryGroups=render video
WorkingDirectory=/opt/transcode-agent
EnvironmentFile=/etc/transcode-agent.env
ExecStart=/usr/bin/python3 /opt/transcode-agent/adm-agent.pyz server agent run
Restart=on-failure
RestartSec=5
# Stopping cancels any encode; ffmpeg children are in this unit's cgroup and are
# stopped with it.
TimeoutStopSec=60
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
