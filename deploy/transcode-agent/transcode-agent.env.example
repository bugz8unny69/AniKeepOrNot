# /etc/transcode-agent.env — chmod 600, owned by root.
TRANSCODE_LISTEN=0.0.0.0:8787
# The same token goes into AniKeepOrNot: Settings > Transcode > agent token.
TRANSCODE_TOKEN=change-me-to-a-long-random-string
# gpu, cpu or gpu,cpu. Order does not matter: GPU is always tried first.
TRANSCODE_ENCODERS=gpu,cpu
TRANSCODE_VAAPI_DEVICE=/dev/dri/renderD128
# Only <TRANSCODE_TMP>/transcode-agent/ is used and wiped. Needs ~1.5x the video's size free.
TRANSCODE_TMP=/var/tmp
