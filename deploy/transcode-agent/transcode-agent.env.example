# Transcode agent settings. `adm-agent.pyz agent install` writes this file
# (system: /etc/transcode-agent.env; user: ~/.config/anikeepornot/transcode-agent/
# transcode-agent.env), mode 600, and keeps your values on every rerun.
TRANSCODE_LISTEN=0.0.0.0:8787
# The token AniKeepOrNot sends; save the same value for this agent under
# Settings > Transcode > Remote. Show it with: adm-agent.pyz agent token
TRANSCODE_TOKEN=change-me-to-a-long-random-string
# gpu, cpu or gpu,cpu. Order does not matter: GPU is always tried first.
TRANSCODE_ENCODERS=gpu,cpu
TRANSCODE_VAAPI_DEVICE=/dev/dri/renderD128
# Only <TRANSCODE_TMP>/transcode-agent/ is used and wiped. Needs ~1.5x the video's size free.
TRANSCODE_TMP=/var/tmp
