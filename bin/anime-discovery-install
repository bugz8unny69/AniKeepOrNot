#!/usr/bin/env python3
"""Install/upgrade Anime Discovery. Interactive by default; --yes uses explicit flags/defaults.

This standalone launcher needs only Python's standard library. It provisions a
versioned release, uses native setup commands as the service user, and preserves
existing settings/credentials. It never imports the legacy operational database.
"""
import argparse
import contextlib
import fcntl
import grp
import json
import os
from pathlib import Path
import pwd
import re
import shlex
import shutil
import stat
import subprocess
import sys
import tarfile
import tempfile
import time
import uuid
from urllib.parse import urlsplit

DEFAULTS={'root':'/opt/anime-discovery','state_dir':'/var/lib/anime-discovery',
    'config_dir':'/etc/anime-discovery','user':'anime-discovery',
    'source':'git@github.com:bugz8unny69/anime-discovery.git','ref':'NextGen',
    'destination':'/usr/local/bin/anime-discovery-install','unit_dir':'/etc/systemd/system','python':'python3'}
SERVICES=('anime-discovery-api.service','anime-discovery-worker.service')
# Set when an upgrade re-runs the installer it just fetched, so it runs once.
REEXEC_ENV='ANIME_DISCOVERY_INSTALLER_REEXEC'
RELEASE_INFO='.anime-discovery-release.json'


class Reexec(Exception):
    """The fetched release brings a different installer: run that one instead."""
    def __init__(self,checkout,revision):
        super().__init__('re-run the fetched installer')
        self.checkout,self.revision=checkout,revision


def run(args,*,cwd=None,input=None,check=True):
    result=subprocess.run([str(x) for x in args],cwd=cwd,input=input,text=True,capture_output=True)
    if check and result.returncode:
        command=Path(str(args[0])).name
        detail=(result.stderr or result.stdout).strip()
        # Provider output may embed credentials; report the failing operation
        # and exit status, with diagnostic output only for local safe tools.
        safe={'systemctl','python3','runuser','useradd','git'}
        if command not in safe:detail=''
        if command=='git' and ('@' in detail or 'token' in detail.lower()):detail=''
        suffix=('; detail: '+detail[:400]) if detail else ''
        raise RuntimeError(f'{command} exited with status {result.returncode}{suffix}')
    return result


def private_json(path):
    fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)
    with os.fdopen(fd,'r') as stream:
        info=os.fstat(stream.fileno())
        if not stat.S_ISREG(info.st_mode):raise ValueError('Expected a regular JSON file.')
        data=json.loads(stream.read(65537))
    if type(data) is not dict:raise ValueError('Expected a JSON object.')
    return data


def atomic_file(path,content,mode):
    path=Path(path);fd,name=tempfile.mkstemp(prefix='.'+path.name+'-',dir=path.parent)
    try:
        with os.fdopen(fd,'wb') as stream:
            os.fchmod(stream.fileno(),mode);stream.write(content);stream.flush();os.fsync(stream.fileno())
        os.replace(name,path)
        directory=os.open(path.parent,os.O_RDONLY|os.O_DIRECTORY)
        try:os.fsync(directory)
        finally:os.close(directory)
    finally:
        if os.path.exists(name):os.unlink(name)


def adm_launcher(root,config_dir):
    """Keep the local ADM command on the active branch's settings/database."""
    current=Path(root)/'current'
    return ('#!/bin/sh\n'
            'ANIME_DISCOVERY_CONFIG_DIR='+shlex.quote(str(config_dir))+'\n'
            'export ANIME_DISCOVERY_CONFIG_DIR\n'
            'exec '+shlex.quote(str(current/'.venv/bin/python'))+' '
            +shlex.quote(str(current/'bin/adm'))+' "$@"\n')


def write_adm_launcher(destination,root,config_dir):
    atomic_file(Path(destination).parent/'adm',adm_launcher(root,config_dir).encode(),0o755)


def _saved_installation_file(path):
    info=path.lstat();parent=path.parent.stat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid!=0 or info.st_mode&0o077:
        raise ValueError('Installer metadata must be a private root-owned regular file.')
    if parent.st_uid!=0 or parent.st_mode&0o022:
        raise ValueError('Installer metadata directory must be root-owned and protected.')
    return {k:v for k,v in private_json(path).items() if k in (*DEFAULTS,'origin','branches','config_base')}


def saved_defaults():
    # This executable may be run from a checkout or /usr/local/bin. Neither
    # the working directory nor the launcher location identifies the install.
    candidates=[
        Path(str(Path(__file__).resolve())+'.json'),
        Path(str(Path(DEFAULTS['destination']))+'.json'),
    ]
    bootstrap={}
    for locator in candidates:
        if locator.exists():
            bootstrap=_saved_installation_file(locator)
            break
    root=Path(bootstrap.get('root',DEFAULTS['root']))
    state=Path(bootstrap.get('state_dir',DEFAULTS['state_dir']))
    # Read the old application-folder metadata once to discover custom paths.
    legacy=root/'installer.json'
    if legacy.exists():
        bootstrap=_saved_installation_file(legacy)
        state=Path(bootstrap.get('state_dir',str(state)))
    canonical=state/'installer'/'installer.json'
    if canonical.exists():
        return _saved_installation_file(canonical)
    if bootstrap:
        return bootstrap
    # Older installs can be found from their native configuration even when
    # the prior launcher metadata has been lost.
    existing=Path(DEFAULTS['config_dir'])/'settings.json'
    if existing.is_file() and (root/'current').is_symlink():
        return DEFAULTS.copy()
    return {}


def parser():
    # No abbreviations: "--install" must not silently mean --install-system-deps.
    p=argparse.ArgumentParser(description=__doc__,allow_abbrev=False)
    # Without a mode the command installs; --upgrade and --rollback act on an existing installation.
    modes=p.add_mutually_exclusive_group();modes.add_argument('--upgrade',action='store_true')
    modes.add_argument('--rollback',action='store_true',help='Switch back to the previous installed version, if the database and settings are still compatible with it.')
    for name in DEFAULTS:p.add_argument('--'+name.replace('_','-'))
    p.add_argument('--public-origin',dest='origin',help='Exact HTTPS dashboard origin, or loopback HTTP. Existing installed origin is retained.')
    p.add_argument('--branch',help='Git branch to install from, for example NextGen or refactor. With --upgrade it '
                   'switches the installation to that branch, and later upgrades keep using it.')
    p.add_argument('--copy-db-data',action='store_true',help='With --upgrade --branch to a branch used for the first time: '
                   'start its database as a copy of the current branch\'s, if the two branches\' migration histories match. '
                   'Without it the new branch starts with an empty database. Each branch keeps its own settings and database.')
    p.add_argument('--source-dir',type=Path,help='Use tracked files from an existing local Git checkout instead of fetching.')
    p.add_argument('--revision',help='Exact Git commit to install; defaults to the selected branch head.')
    p.add_argument('--database',type=Path,help='New Anime Discovery database path; existing configuration always wins.')
    p.add_argument('--settings-file',type=Path,help='Initial native settings object.')
    p.add_argument('--webhook-key-file',type=Path)
    p.add_argument('--admin-password-file',type=Path,help='Provision a fresh administrator through ADM after API startup. Existing passwords are preserved.')
    p.add_argument('--install-system-deps',action='store_true',help='Install git, Python venv/pip and ffmpeg using apt-get (Debian/Ubuntu).')
    p.add_argument('--start',choices=('preserve','api','all','none'),default='preserve')
    p.add_argument('--enable',action='store_true',help='Enable the selected API/worker services at boot.')
    p.add_argument('--yes',action='store_true',help='Do not ask questions. Never enables optional OS package installation implicitly.')
    p.add_argument('--json',action='store_true',help='Print machine-readable results; use --yes for unattended installation.')
    return p


def resolve(args):
    saved=saved_defaults()
    options={**DEFAULTS,**saved}
    if args.upgrade or args.rollback:
        if not saved:
            raise ValueError(('Rollback' if args.rollback else 'Upgrade')+' requires an existing installation. '
                             'Install it first: run anime-discovery-install without --upgrade.')
        for k in (*DEFAULTS,'origin'):
            requested=getattr(args,k,None)
            if requested is not None and requested!=options.get(k):
                raise ValueError('Upgrade cannot change installation settings: '+k
                                 +(' (use --branch to switch branches)' if k=='ref' else ''))
        if any((args.database,args.settings_file,args.webhook_key_file,args.admin_password_file,args.install_system_deps)):
            raise ValueError('Upgrade cannot reconfigure installation or credentials.')
    else:
        for k in (*DEFAULTS,'origin'):
            if getattr(args,k,None) is not None:options[k]=getattr(args,k)
    # --branch is the one setting an upgrade may change; it is saved for later upgrades.
    current_ref=options['ref']
    if getattr(args,'branch',None) is not None:
        if args.rollback:raise ValueError('--branch cannot be combined with --rollback.')
        if getattr(args,'ref',None) is not None and args.ref!=args.branch:raise ValueError('Use --branch or --ref, not both.')
        options['ref']=args.branch
    resolve_branch_state(options,args,saved,current_ref)
    # Upgrades reuse the saved installation configuration. Only a fresh
    # installation asks the operator to choose paths and a public origin.
    interactive=not(args.yes or args.upgrade or args.rollback)
    if interactive:
        for name,label in [('root','Application folder'),('config_dir','Anime Discovery config folder'),('user','Service account')]:
            if getattr(args,name) is None:options[name]=input(label+' ['+options[name]+']: ').strip() or options[name]
    for name in ('root','state_dir','config_dir','destination','unit_dir'):
        value=options[name]
        if not re.fullmatch(r'/[A-Za-z0-9_./-]+',value) or '..' in Path(value).parts or str(Path(value))=='/':raise ValueError('Use absolute infrastructure paths with letters, numbers, dots, dashes and underscores.')
        options[name]=str(Path(value))
    source=urlsplit(options['source'])
    if any(ord(c)<32 for c in options['source']) or source.scheme in ('http','https') and source.username is not None:raise ValueError('Use SSH or a Git credential helper instead of credentials in the source URL.')
    if not re.fullmatch(r'[a-z_][a-z0-9_-]{0,31}',options['user']):raise ValueError('Invalid service user.')
    if not re.fullmatch(r'[A-Za-z0-9_][A-Za-z0-9_./-]*',options['ref']):raise ValueError('Invalid Git ref.')
    if args.revision and not re.fullmatch('[a-f0-9]{40,64}',args.revision):raise ValueError('Use an exact Git revision.')
    if options.get('origin') is None:
        unit=Path(options['unit_dir'])/SERVICES[0]
        if unit.is_file():
            for line in unit.read_text().splitlines():
                if line.startswith('ExecStart='):
                    words=shlex.split(line.partition('=')[2])
                    if '--public-origin' in words:options['origin']=words[words.index('--public-origin')+1]
    if interactive and args.origin is None:
        options['origin']=input('Public dashboard origin ['+(options.get('origin') or 'loopback HTTP')+']: ').strip() or options.get('origin')
    options.setdefault('origin',None)
    options['database']=str(args.database or Path(options['state_dir'])/'anime-discovery.sqlite')
    existing=Path(options['config_dir'])/'settings.json'
    if options['switch']=='new':
        # First use of a branch: its own folder and database, never an existing one.
        for path,what in ((Path(options['config_dir']),'settings folder'),(Path(options['new_database']),'database')):
            if path.exists() or path.is_symlink():
                raise ValueError(f"A {what} for branch {options['ref']} already exists at {path} "
                                 '(perhaps from an interrupted switch). Move it away, then try again.')
        if not (Path(options['switch_from']['config_dir'])/'settings.json').is_file():
            raise ValueError('The current branch has no native settings to start the new branch from.')
        options['database']=options['new_database']
    elif existing.exists():
        doc=private_json(existing)
        if 'schema_version' not in doc:raise ValueError('Choose a separate fresh Anime Discovery configuration directory; legacy conversion is unsupported.')
        options['database']=doc.get('settings',{}).get('storage',{}).get('database_path',options['database'])
    if (args.upgrade or args.rollback) and options['switch']!='new' and not existing.exists():
        raise ValueError('Upgrade needs an existing native Anime Discovery configuration.')
    return options


def branch_folder(ref):
    """A folder-safe branch name: feature/x -> feature-x."""
    return re.sub(r'[^A-Za-z0-9_.-]+','-',ref).strip('-.') or 'branch'


def resolve_branch_state(options,args,saved,current_ref):
    """Each branch keeps its own settings folder and database.

    Branches can carry different migrations and settings versions, so a branch
    never runs on another branch's database or settings. The first branch
    keeps the folders it was installed with; a branch used for the first time
    gets <config>/branches/<branch>/ and <state>/anime-discovery-<branch>.sqlite.
    """
    branches={ref:dict(entry) for ref,entry in (saved.get('branches') or {}).items()}
    options['config_base']=saved.get('config_base') or options['config_dir']
    options['switch']=None
    switching=bool(args.upgrade and getattr(args,'branch',None) is not None and args.branch!=current_ref)
    if getattr(args,'copy_db_data',False) and not switching:
        raise ValueError('--copy-db-data only applies when --upgrade --branch switches to another branch.')
    if switching:
        branches.setdefault(current_ref,{'config_dir':options['config_dir']})
        options['switch_from']={'ref':current_ref,'config_dir':options['config_dir']}
        if args.branch in branches:
            if args.copy_db_data:
                raise ValueError(f'Branch {args.branch} is already set up and keeps its own database; '
                                 '--copy-db-data only applies to a branch used for the first time.')
            options['config_dir']=branches[args.branch]['config_dir'];options['switch']='existing'
        else:
            label=branch_folder(args.branch)
            options['config_dir']=str(Path(options['config_base'])/'branches'/label)
            options['new_database']=str(Path(options['state_dir'])/f'anime-discovery-{label}.sqlite')
            options['switch']='new'
    options['branches']=branches


def extract_checkout(source,release,revision,execute=run):
    sha=execute(['git','-c','safe.directory='+str(source),'-C',str(source),'rev-parse',revision or 'HEAD']).stdout.strip()
    archive=release/'source.tar'
    execute(['git','-c','safe.directory='+str(source),'-C',str(source),'archive','--format=tar','--output='+str(archive),sha])
    with tarfile.open(archive) as stream:
        for item in stream.getmembers():
            path=Path(item.name)
            if path.is_absolute() or '..' in path.parts or not(item.isfile() or item.isdir()):raise ValueError('Source archive contains unsupported paths or links.')
        stream.extractall(release)
    archive.unlink();return sha


def package(release):
    """The Python package a release ships: "anime" on refactor, the older
    "nextgen" package on NextGen releases. Rollback and branch switches run an
    older release's code, so each release is run with its own package."""
    for name in ('anime','next'+'gen'):
        if (Path(release)/'src'/name/'__main__.py').is_file():return 'src.'+name
    return 'src.anime'


def service_call(release,options,command,payload,execute=run):
    result=execute(['runuser','-u',options['user'],'--',release/'.venv/bin/python','-m',package(release)+'.install_support',command,
        '--config-dir',options['config_dir']],cwd=release,input=json.dumps(payload))
    return json.loads(result.stdout)


def release_name(releases,ref,revision,*,today=None):
    """A readable, unique folder name: <date>-<branch>-<short commit>."""
    label=re.sub(r'[^A-Za-z0-9_.-]+','-',ref).strip('-.') or 'release'
    base=f"{today or time.strftime('%Y-%m-%d')}-{label}-{revision[:8]}"
    name,n=base,2
    while (releases/name).exists() or (releases/name).is_symlink():
        name=f'{base}-{n}';n+=1
    return name


def prune_releases(root,state,keep):
    """Keep only the given releases (the running one and one previous).

    Deletes every other folder in releases/, including old random-named ones
    and leftovers of interrupted runs, and the unit-file backups that belong
    to the deleted releases. Symlinks are never followed or deleted.
    """
    releases=root/'releases';kept={Path(k).name for k in keep if k}
    removed=[]
    for entry in sorted(releases.iterdir()):
        if entry.name in kept or entry.is_symlink() or not entry.is_dir():continue
        shutil.rmtree(entry);removed.append(entry.name)
    backups=state/'installer'/'unit-backups'
    if backups.is_dir() and not backups.is_symlink():
        for entry in sorted(backups.iterdir()):
            if entry.name not in kept and entry.is_dir() and not entry.is_symlink():shutil.rmtree(entry)
    return removed


def should_reexec(args,candidate,running=None):
    """An upgrade whose fetched installer differs from the running one re-runs it, once."""
    if not args.upgrade or os.environ.get(REEXEC_ENV)=='1':return False
    running=Path(running or __file__)
    try:return running.read_bytes()!=(candidate/'bin/anime-discovery-install').read_bytes()
    except OSError:return False


def apply(options,args,execute=run):
    if os.geteuid()!=0:raise PermissionError('Run the installer with sudo.')
    if args.install_system_deps:
        if not shutil.which('apt-get'):raise RuntimeError('Automatic OS dependencies support apt-get. Install Python 3.11+, venv, pip, git and ffprobe manually on other systems.')
        execute(['apt-get','update']);execute(['env','DEBIAN_FRONTEND=noninteractive','apt-get','install','-y','git','python3','python3-venv','python3-pip','ffmpeg'])
    execute([options['python'],'-c','import sys; assert sys.version_info >= (3,11)'])
    for cmd in ('git','runuser','systemctl'):
        if not shutil.which(cmd):raise RuntimeError('Missing required tool: '+cmd)
    root=Path(options['root']);state=Path(options['state_dir']);config=Path(options['config_dir'])
    if root.is_symlink() or (root/'releases').is_symlink():raise ValueError('Install folders must not be symlinks.')
    root.mkdir(parents=True,exist_ok=True);(root/'releases').mkdir(exist_ok=True)
    for path in (root,root/'releases'):
        os.chown(path,0,0);os.chmod(path,0o755)
    if (root/'current').exists() and not(root/'current').is_symlink():raise ValueError('The release pointer is occupied by an existing file/folder.')
    if state.is_symlink():raise ValueError('State folder must not be a symlink.')
    state_created=not state.exists()
    state.mkdir(parents=True,exist_ok=True,mode=0o750)
    metadata=state/'installer'
    if metadata.is_symlink():raise ValueError('Installer state folder must not be a symlink.')
    metadata.mkdir(exist_ok=True,mode=0o700)
    info=metadata.stat()
    if info.st_uid!=0 or info.st_mode&0o077:raise ValueError('Installer state folder must be private and root-owned.')
    lock=os.open(metadata/'.installer.lock',os.O_WRONLY|os.O_CREAT|os.O_NOFOLLOW,0o600)
    setup_started=False
    previous_umask=os.umask(0o022)  # Source/venv readable by the non-root service account.
    try:
        fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
        try:account=pwd.getpwnam(options['user'])
        except KeyError:
            execute(['useradd','--system','--user-group','--home-dir',str(state),'--shell','/usr/sbin/nologin',options['user']])
            account=pwd.getpwnam(options['user'])
        if account.pw_uid==0 or grp.getgrnam(options['user']).gr_gid!=account.pw_gid:raise ValueError('Use a dedicated non-root account with a matching primary group.')
        if state_created:os.chown(state,account.pw_uid,account.pw_gid)
        for path,mode in [(state,0o750),(config.parent,0o750)]:
            if not path.exists():path.mkdir(parents=True,mode=mode);os.chown(path,account.pw_uid,account.pw_gid)
        incoming=root/'releases'/('.incoming-'+uuid.uuid4().hex);incoming.mkdir(mode=0o755)
        print('Preparing candidate source and Python environment...',flush=True)
        if args.source_dir:revision=extract_checkout(args.source_dir,incoming,args.revision,execute)
        else:
            incoming.rmdir();execute(['git','clone','--no-checkout','--',options['source'],str(incoming)])
            execute(['git','-C',str(incoming),'fetch','--depth=1','--no-tags','origin',args.revision or options['ref']])
            revision=execute(['git','-C',str(incoming),'rev-parse','FETCH_HEAD']).stdout.strip()
            execute(['git','-C',str(incoming),'checkout','--detach',revision])
        if not re.fullmatch('[a-f0-9]{40,64}',revision):raise ValueError('Source did not resolve to an exact revision.')
        if should_reexec(args,incoming):
            raise Reexec(incoming,revision)       # main() runs the new installer on this checkout.
        # The final, readable name is given before the virtualenv is created:
        # a virtualenv records its own path and must not move afterwards.
        # A --source-dir install is labelled "local", except the re-run of a
        # fetched installer, whose checkout is the configured branch.
        label=options['ref'] if not args.source_dir or os.environ.get(REEXEC_ENV)=='1' else 'local'
        release=root/'releases'/release_name(root/'releases',label,revision)
        os.rename(incoming,release)
        atomic_file(release/RELEASE_INFO,(json.dumps({'revision':revision,'ref':options['ref'],
            'installed_at':time.strftime('%Y-%m-%dT%H:%M:%S%z')},sort_keys=True)+'\n').encode(),0o644)
        for required in ('src/anime/__main__.py','src/anime/install_support.py','bin/anime-discovery-install','bin/adm'):
            if not (release/required).is_file():raise ValueError('Selected source does not contain the Anime Discovery installer.')
        execute([options['python'],'-m','venv',str(release/'.venv')])
        execute([str(release/'.venv/bin/python'),'-m','pip','install','--disable-pip-version-check','-r',str(release/'requirements-nextgen-api.txt')])
        # Build first; stop only once the candidate is ready for local setup.
        active=[name for name in SERVICES if execute(['systemctl','is-active','--quiet',name],check=False).returncode==0]
        previous=os.readlink(root/'current') if (root/'current').is_symlink() else None
        had_config=(config/'settings.json').exists()
        atomic_file(metadata/'installation.pending.json',(json.dumps({'candidate':str(release),'previous_release':previous,'revision':revision},sort_keys=True)+'\n').encode(),0o600)
        print('Stopping Anime Discovery services for local setup...',flush=True)
        installed=[name for name in ('anime-discovery.target',*SERVICES)
            if execute(['systemctl','show','--property=LoadState','--value',name],check=False).stdout.strip() not in ('','not-found')]
        setup_started=True
        if installed:execute(['systemctl','stop',*installed])
        new_branch=options.get('switch')=='new'
        if new_branch:branch_state=(config,Path(options['database']))   # Removed again if setup fails early.
        if not config.exists():config.mkdir(mode=0o700);os.chown(config,account.pw_uid,account.pw_gid)
        if new_branch:
            source_release=Path(previous) if previous else None
            if source_release is not None and not source_release.is_absolute():source_release=root/source_release
            if source_release is None or not (source_release/'src/anime/storage/sql').is_dir():
                raise ValueError('The current release is not installed, so its data cannot be checked.')
            print(f"Setting up branch {options['ref']}: its own settings"
                  +(' and a copy of the current database...' if args.copy_db_data else ' and a new database...'),flush=True)
            branch_result=service_call(release,options,'branch-setup',{
                'source_config_dir':options['switch_from']['config_dir'],'database':options['database'],
                'source_sql_dir':str(source_release/'src/anime/storage/sql'),
                'copy_data':bool(args.copy_db_data)},execute)
        settings={} if args.settings_file is None else private_json(args.settings_file)
        access={}
        for key,path in [('webhook_token',args.webhook_key_file)]:
            if path:
                fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)
                with os.fdopen(fd,'r') as stream:
                    if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):raise ValueError('Expected a private key file.')
                    access[key]=stream.read(4097).strip()
        if not (args.yes or args.upgrade) and not(config/'secrets.json').exists():
            import getpass
            for key,label in [('webhook_token','Webhook key')]:
                if key not in access:access[key]=getpass.getpass(label+' (blank generates a new key): ')
        payload={**options,'settings':settings,'access':access}
        service_call(release,options,'prepare',payload,execute)
        units=service_call(release,options,'render',options,execute)
        # Preserve the pre-upgrade runtime state. Never start a worker that was
        # intentionally stopped; start API before worker when both were active.
        selected=(list(SERVICES) if args.start=='all' else [SERVICES[0]] if args.start=='api' else [] if args.start=='none'
            else active if args.upgrade else active if previous or had_config or active else [SERVICES[0]])
        if SERVICES[1] in selected:service_call(release,options,'check-worker',{},execute)
        branch_state=None   # Units change from here on; a failure now leaves state for recovery.
        unit_dir=Path(options['unit_dir']);unit_dir.mkdir(parents=True,exist_ok=True)
        backup=metadata/'unit-backups'/release.name;backup.mkdir(parents=True,mode=0o700)
        for name,body in units.items():
            old=unit_dir/name
            if old.exists():shutil.copyfile(old,backup/name)
            atomic_file(old,body.encode(),0o644)
        pointer=root/('.current-'+release.name);pointer.symlink_to(release)
        os.replace(pointer,root/'current')
        execute(['systemctl','daemon-reload'])
        if args.enable and selected:execute(['systemctl','enable',*selected])
        if selected:
            execute(['systemctl','start',*selected])
            for name in selected:
                status=execute(['systemctl','is-active','--quiet',name],check=False)
                if status.returncode:
                    raise RuntimeError('Service did not return to active state after '
                        + ('upgrade' if args.upgrade else 'installation') + ': '+name
                        +' (systemctl is-active status '+str(status.returncode)+')')
        if args.admin_password_file:
            if SERVICES[0] not in selected:raise ValueError('Password provisioning requires --start api or all.')
            # ADM is the sole password bootstrap path; never write the password store directly.
            fd=os.open(args.admin_password_file,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)
            with os.fdopen(fd,'r') as stream:
                if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):raise ValueError('Expected a password file.')
                password=stream.read(1026)
            execute(['runuser','-u',options['user'],'--',release/'.venv/bin/python','-m',
                package(release)+'.api.adm','set-password','--if-unset','--password-stdin'],cwd=release,input=password)
        destination=Path(options['destination']);destination.parent.mkdir(parents=True,exist_ok=True)
        atomic_file(destination,(release/'bin/anime-discovery-install').read_bytes(),0o755)
        write_adm_launcher(destination,root,config)
        branches=dict(options.get('branches') or {})
        branches[options['ref']]={'config_dir':options['config_dir']}
        saved={**{k:options[k] for k in (*DEFAULTS,'origin')},'branches':branches,'config_base':options.get('config_base',options['config_dir'])}
        atomic_file(metadata/'installer.json',(json.dumps(saved,sort_keys=True)+'\n').encode(),0o600)
        # A nondefault installation needs a tiny root locator because the
        # standalone command itself lives outside that application directory.
        # Never store mutable installation settings in the launcher directory.
        if root!=Path(DEFAULTS['root']) or state!=Path(DEFAULTS['state_dir']):
            atomic_file(Path(str(destination)+'.json'),(json.dumps({'root':str(root),'state_dir':str(state)},sort_keys=True)+'\n').encode(),0o600)
        result={'installed':True,'revision':revision,'previous_release':previous,'release':str(release),
            'configuration_preserved':True,'started_services':selected,
            'previously_running_services':active,
            'remaining_stopped_services':[name for name in SERVICES if name not in selected],
            'credentials_file':str(config/'secrets.json'),'command':str(destination),
            'branch':options['ref'],'database':options['database'],
            'branch_switch':options.get('switch'),
            'database_copied_from_version':(branch_result.get('copied_from_version') if new_branch else None)}
        atomic_file(metadata/'installation.json',(json.dumps(result,sort_keys=True)+'\n').encode(),0o600)
        (metadata/'installation.pending.json').unlink()
        # Keep the running release and one previous; everything older goes.
        result['removed_releases']=prune_releases(root,state,(release,previous))
        # Remove obsolete JSON only after the new installation succeeds.
        for name in ('installer.json','installation.json','installation.pending.json'):
            (root/name).unlink(missing_ok=True)
        return result
    except BaseException:
        if setup_started and locals().get('branch_state'):
            # The new branch's folder and database were created by this run and never used.
            folder,database=branch_state
            shutil.rmtree(folder,ignore_errors=True)
            for suffix in ('','-wal','-shm','-journal'):Path(str(database)+suffix).unlink(missing_ok=True)
        if setup_started:
            # Schema may have advanced: never restart older source or restore a
            # database automatically. Retain pending metadata for the next run.
            execute(['systemctl','stop','anime-discovery.target',*SERVICES],check=False)
        raise
    finally:
        os.umask(previous_umask)
        os.close(lock)


def rollback(options,args,execute=run):
    """Switch current back to the previous release, if it can still run.

    The previous release checks the database and settings itself (its own
    `python -m src.anime check`): a database or settings file that was
    upgraded beyond what it understands refuses the rollback. Nothing is
    deleted; the newer release becomes the previous one.
    """
    if os.geteuid()!=0:raise PermissionError('Run the installer with sudo.')
    root=Path(options['root']);state=Path(options['state_dir']);metadata=state/'installer'
    releases=root/'releases'
    if not (root/'current').is_symlink():raise ValueError('No installed release to roll back from.')
    current=Path(os.readlink(root/'current'))
    current=current if current.is_absolute() else root/current
    recorded=private_json(metadata/'installation.json') if (metadata/'installation.json').is_file() else {}
    previous=recorded.get('previous_release')
    if not previous:raise ValueError('No previous release is recorded; there is nothing to roll back to.')
    previous=Path(previous)
    previous=previous if previous.is_absolute() else root/previous
    if (previous.parent!=releases or previous.is_symlink() or not previous.is_dir()
            or previous.resolve()==current.resolve()):
        raise ValueError('The recorded previous release is no longer installed: '+str(previous))
    # The previous release may belong to another branch: use that branch's own settings.
    info=previous/RELEASE_INFO
    previous_ref=private_json(info).get('ref') if info.is_file() else None
    branches=options.get('branches') or {}
    config_dir=branches.get(previous_ref,{}).get('config_dir',options['config_dir']) if previous_ref else options['config_dir']
    lock=os.open(metadata/'.installer.lock',os.O_WRONLY|os.O_CREAT|os.O_NOFOLLOW,0o600)
    try:
        fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
        check=execute(['runuser','-u',options['user'],'--',previous/'.venv/bin/python','-m',package(previous),'check',
                       '--config-dir',config_dir],cwd=previous,check=False)
        if check.returncode:
            reason=' '.join((check.stderr or check.stdout or '').split())[:400] or 'status '+str(check.returncode)
            raise ValueError('Cannot roll back to '+previous.name+': it cannot use the current database or '
                             'settings (they were upgraded beyond what it understands). '+reason)
        active=[name for name in SERVICES if execute(['systemctl','is-active','--quiet',name],check=False).returncode==0]
        if active:execute(['systemctl','stop',*active])
        # The unit files saved when the current release was installed are the previous release's.
        backup=metadata/'unit-backups'/current.name
        if backup.is_dir():
            for unit in sorted(backup.iterdir()):
                atomic_file(Path(options['unit_dir'])/unit.name,unit.read_bytes(),0o644)
        pointer=root/('.current-'+previous.name);pointer.symlink_to(previous)
        os.replace(pointer,root/'current')
        write_adm_launcher(options['destination'],root,config_dir)
        execute(['systemctl','daemon-reload'])
        if active:
            execute(['systemctl','start',*active])
            for name in active:
                if execute(['systemctl','is-active','--quiet',name],check=False).returncode:
                    raise RuntimeError('Service did not return to active state after rollback: '+name)
        revision=private_json(info).get('revision') if info.is_file() else None
        if previous_ref and (metadata/'installer.json').is_file():
            # Later upgrades continue on the branch that is running now.
            saved=private_json(metadata/'installer.json')
            saved.update({'ref':previous_ref,'config_dir':config_dir})
            atomic_file(metadata/'installer.json',(json.dumps(saved,sort_keys=True)+'\n').encode(),0o600)
        result={**recorded,'rolled_back':True,'release':str(previous),'previous_release':str(current),
                'revision':revision,'started_services':active,'branch':previous_ref}
        atomic_file(metadata/'installation.json',(json.dumps(result,sort_keys=True)+'\n').encode(),0o600)
        return result
    finally:
        os.close(lock)


def _reexec(argv,error):
    """Run the installer the upgrade just fetched, on that same checkout, once."""
    args=list(argv if argv is not None else sys.argv[1:])
    for flag in ('--source-dir','--revision'):
        while flag in args:
            i=args.index(flag);del args[i:i+2]
    command=[sys.executable,str(error.checkout/'bin/anime-discovery-install'),*args,
             '--source-dir',str(error.checkout),'--revision',error.revision]
    print('This upgrade brings a newer installer; continuing with it...',file=sys.stderr,flush=True)
    try:
        return subprocess.run(command,env={**os.environ,REEXEC_ENV:'1'}).returncode
    finally:
        shutil.rmtree(error.checkout,ignore_errors=True)


def main(argv=None):
    args=parser().parse_args(argv)
    try:
        options=resolve(args)
        if args.rollback:
            with contextlib.redirect_stdout(sys.stderr if args.json else sys.stdout):
                result=rollback(options,args)
            if args.json:print(json.dumps(result,sort_keys=True))
            else:
                print('\nRolled back to '+Path(result['release']).name+'.')
                print('Newer release kept as the previous one: '+Path(result['previous_release']).name)
                print('Restarted services: '+(', '.join(result['started_services']) or 'none'))
            return 0
        if not args.yes and not args.upgrade and input('Install Anime Discovery with these paths? [y/N]: ').strip().lower() not in ('y','yes'):return 0
        try:
            with contextlib.redirect_stdout(sys.stderr if args.json else sys.stdout):
                result=apply(options,args)
        except Reexec as error:
            return _reexec(argv,error)
        if args.json:
            print(json.dumps(result,sort_keys=True))
        else:
            started=result.get('started_services',[])
            if args.upgrade:
                print('\nAnime Discovery upgraded successfully.')
                print('Revision: '+result['revision'])
                if started:
                    print('Restarted services: '+', '.join(started))
                else:
                    print('Restarted services: none (no services were running before upgrade).')
                remaining=result.get('remaining_stopped_services',[])
                if remaining:
                    print('Remained stopped: '+', '.join(remaining))
                switch=result.get('branch_switch')
                if switch=='new':
                    copied=result.get('database_copied_from_version')
                    print('Branch '+result['branch']+' set up with its own settings and '
                          +(f'a copy of the previous branch\'s database (schema v{copied}, then upgraded).' if copied
                            else 'a new, empty database.'))
                    print('Database: '+result['database'])
                elif switch=='existing':
                    print('Switched to branch '+result['branch']+', using its own settings and database.')
                else:
                    print('Configuration and credentials preserved.')
                if result.get('removed_releases'):
                    print('Removed old releases: '+', '.join(result['removed_releases']))
            else:
                print('\nAnime Discovery installation completed successfully.')
                print('Configuration: '+options['config_dir'])
                print('Existing settings and credentials were preserved.')
                if started:
                    print('Started services: '+', '.join(started))
                else:
                    print('No services were started.')
                if SERVICES[0] not in started:
                    print('Start the API: systemctl start anime-discovery-api.service')
                print('Set or reset the dashboard password:')
                print('  '+shlex.join(['sudo',str(Path(options['root'])/'current/bin/adm'),'set-password']))
                if options.get('origin'):print('Dashboard: '+options['origin'])
                print('Future upgrades: '+shlex.join([options['destination'],'--upgrade']))
        return 0
    except (OSError,ValueError,RuntimeError,KeyError) as exc:
        label='Rollback' if args.rollback else 'Upgrade' if args.upgrade else 'Installation'
        print(f'{label} failed: {type(exc).__name__}: {exc}',file=sys.stderr)
        return 1


if __name__=='__main__':raise SystemExit(main())
